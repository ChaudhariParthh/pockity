# Pockity environment configuration
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit a real .env — it's in .gitignore.

# ============================================
# REQUIRED: Connect your Supabase project
# ============================================

# Supabase project URL - find in your Supabase dashboard
SUPABASE_URL="https://your-project.supabase.co"

# Supabase publishable (anon) key - find in Supabase > Settings > API
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase project ID - 8-10 character project identifier
SUPABASE_PROJECT_ID="your-project-id"

# ============================================
# REQUIRED: VITE-prefixed versions (for browser builds)
# ============================================

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ============================================
# OPTIONAL: Server-side only (never exposed to client)
# ============================================
# SUPABASE_SERVICE_ROLE_KEY=""